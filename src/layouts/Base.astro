---
import { totalXp as dayXp, levels } from '../data/days';
import { terms } from '../data/terms';
import { drills } from '../data/drills';
const totalXp = dayXp + terms.length * 10 + drills.length * 10 + 11 * 75;
const { title = 'CTO Sprint' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title} · CTO Sprint</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/style.css" />
</head>
<body data-total-xp={totalXp} data-levels={JSON.stringify(levels)}>
<header class="hud">
  <div class="in">
    <a class="logo" href="/">CTO<span>/</span>SPRINT ⚡</a>
    <nav><a href="/">Dashboard</a><a href="/today">Today</a><a href="/boss/1">Bosses</a><a href="/terms">Terms</a><a href="/drills">Drills</a><a href="/terminal">Terminal</a><a href="/journal">Journal</a></nav>
    <div class="stats">
      <span class="pill fire" title="Daily streak">🔥 <b data-hud="streak">0</b></span>
      <span class="pill lvl" data-hud="level">Lv 1</span>
      <span class="pill">⚡ <b data-hud="xp">0</b> XP</span>
    </div>
  </div>
  <div class="xpbar"><i data-hud="bar"></i></div>
</header>
<main class="wrap"><slot /></main>
<div id="timer">
  <div class="row" style="gap:8px"><span class="mode" data-t="mode">🍅 Focus 15</span><button data-t="min" aria-label="minimise" style="margin-left:auto">–</button></div>
  <div class="body">
    <div class="tt" data-t="time">15:00</div>
    <div class="row" style="gap:6px;margin-top:6px"><button data-t="go">Start</button><button data-t="reset">Reset</button><span style="font-size:.8rem">🍅×<b data-t="count">0</b></span></div>
  </div>
</div>
<script type="module" src="/engine.js"></script>
</body>
</html>
